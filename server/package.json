{
  "name": "veda-ai-assessment-server",
  "version": "1.0.0",
  "description": "Backend server for VedaAI Hiring Assignment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npx prisma generate && tsc",
    "start": "export DATABASE_URL=${DATABASE_URL:-file:/tmp/dev.db} && export PRISMA_HOME_DIR=/tmp && export PRISMA_NODEENV_CACHE_DIR=/tmp && npx prisma migrate deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.47.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.10.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
