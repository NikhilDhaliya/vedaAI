datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Assignment {
  id                String   @id @default(uuid())
  title             String
  dueDate           DateTime
  instructions      String?
  questionTypes     String   // Serialized JSON array of selected types (e.g. '["mcq","short"]')
  numberOfQuestions Int
  totalMarks        Int
  uploadedFile      String?  // Local file path
  status            String   // "queued" | "generating" | "completed" | "failed"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  result            Result?
}

model Result {
  id           String     @id @default(uuid())
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sections     Section[]
}

model Section {
  id          String     @id @default(uuid())
  resultId    String
  result      Result     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  title       String     // e.g. "Section A"
  instruction String     // e.g. "Attempt all questions"
  questions   Question[]
}

model Question {
  id         String   @id @default(uuid())
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text       String
  type       String   // "mcq" | "short" | "long" | "numerical" | "diagram"
  options    String?  // Serialized JSON array of choices for MCQ (e.g. '["Choice A", "Choice B"]')
  answer     String?  // Sample or correct answer
  difficulty String   // "easy" | "moderate" | "hard"
  marks      Int
}
